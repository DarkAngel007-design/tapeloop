# Copy to .env and fill in. .env is gitignored; THIS file is committed.
# Never put a real key here.
# M0 runs against any OpenAI-compatible Chat Completions endpoint.

OPENAI_API_KEY=<your-key-here>

# Model id. Check your provider's current catalogue — ids change often.
# Use a cheap tier while building; save budget for the M6 eval runs.
TAPELOOP_MODEL=<model-id>

# Point at any OpenAI-compatible server instead (Ollama, vLLM, Groq,
# Together, OpenRouter). Leave unset for OpenAI itself.
# OPENAI_BASE_URL=http://localhost:11434/v1
