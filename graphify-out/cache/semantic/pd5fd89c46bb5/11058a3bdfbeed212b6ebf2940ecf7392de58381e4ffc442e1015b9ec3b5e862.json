{"nodes": [{"id": "changelog_changelog", "label": "Changelog", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep a Changelog format; semver, pre-1.0 means anything may move."}, {"id": "changelog_provider_id_hardcoded_bug", "label": "Bug \u2014 provider_id Was Hardcoded To openai", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It is hashed into every step key precisely so two backends cannot share a cache entry, so a local Ollama run produced the same key as one against OpenAI. A false cache hit returns an answer that was never given."}, {"id": "changelog_translate_never_called_bug", "label": "Bug \u2014 translate Was Written At M2 And Never Called", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every retry test raised ProviderError directly, so the taxonomy, backoff and Retry-After handling were exercised on a path real code never took. The retry chain had never fired against a real provider in two releases."}, {"id": "changelog_docker_cap_drop_bug", "label": "Bug \u2014 DockerExecutor Could Not Write To The Workspace On Linux", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--cap-drop=ALL removes CAP_DAC_OVERRIDE, so root in the container could not write to a bind-mounted workspace. Perfectly isolated and completely useless. Invisible on macOS."}, {"id": "changelog_tool_result_ordering_renderer_bug", "label": "Bug \u2014 The OpenAI Renderer Did Not Order Tool Results", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The ordering lived only in the tape codec, so a Message built in memory and handed straight to the renderer reached the wire unordered. Found by conformance check C05 on an adapter in production since M1."}, {"id": "changelog_mcp_version_0_0_0_bug", "label": "Bug \u2014 The MCP Server Told Every Host It Was Version 0.0.0", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The version-consistency grep was case-sensitive and only matched 'version =', so SERVER_VERSION = \"0.0.0\" was invisible to the gate that claimed to have eliminated this drift."}, {"id": "changelog_openai_floor_bug", "label": "Bug \u2014 openai>=1.60 Was A Broken Floor", "file_type": "concept", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "omit and ChatCompletionToolUnionParam do not exist before 2.0 and both are used unconditionally, so pip install could resolve a version that fails at import."}], "edges": [{"source": "changelog_changelog", "target": "changelog_provider_id_hardcoded_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "changelog_changelog", "target": "changelog_translate_never_called_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "changelog_changelog", "target": "changelog_docker_cap_drop_bug", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG.md", "source_location": null, "weight": 1.0}, {"source": "changelog_changelog", "target": "changelog_tool_result_ordering_renderer_bug", "relation": "references", "conf