{"nodes": [{"id": "docs_explanation_determinism_determinism", "label": "Determinism (Explanation)", "file_type": "document", "source_file": "docs/explanation/determinism.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Serialization is load-bearing in a way it usually is not, and the failure mode is nasty: a false cache miss looks exactly like replay is broken."}, {"id": "docs_explanation_determinism_canonical_json", "label": "Canonical JSON Serialization", "file_type": "concept", "source_file": "docs/explanation/determinism.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sorted keys, compact separators, explicit float format. Every line serialized identically or the format is worthless."}, {"id": "docs_explanation_determinism_nfc_normalization", "label": "NFC Unicode Normalization", "file_type": "concept", "source_file": "docs/explanation/determinism.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same string to a human is different bytes to sha256; without NFC a model emitting one form and a tape holding the other never agree."}, {"id": "docs_explanation_determinism_nan_rejection", "label": "NaN And Infinity Are Rejected", "file_type": "concept", "source_file": "docs/explanation/determinism.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not valid JSON; Python emits them anyway, producing a file no other parser will read."}, {"id": "docs_explanation_determinism_no_timestamps", "label": "No Timestamps Anywhere", "file_type": "concept", "source_file": "docs/explanation/determinism.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time is recovered from the filesystem: a run's identity is its filename, when it happened is its mtime. Facts about the tape, not contents of it."}, {"id": "docs_explanation_determinism_observer_effect", "label": "The Observer Effect", "file_type": "concept", "source_file": "docs/explanation/determinism.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tape inside the workspace becomes something the agent observes; the second run's listing differs, the step key diverges, and replay misses for no visible reason."}, {"id": "docs_explanation_determinism_determinism_lint", "label": "The Determinism Lint Rule", "file_type": "concept", "source_file": "docs/explanation/determinism.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A test walks the AST of src/ for wall-clock reads and unseeded randomness. Enforced, not intended."}, {"id": "docs_explanation_determinism_retry_jitter_exception", "label": "Retry Jitter \u2014 The One Deliberate Exception", "file_type": "concept", "source_file": "docs/explanation/determinism.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retry timing is transport-level: it never reaches a prompt, a step key, or the tape. The policy still owns a seeded RNG."}], "edges": [{"source": "docs_explanation_determinism_determinism", "target": "docs_explanation_determinism_canonical_json", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/determinism.md", "source_location": null, "weight": 1.0}, {"source": "docs_explanation_determinism_determinism", "target": "docs_explanation_determinism_nfc_normalization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/determinism.md", "source_location": null, "weight": 1.0}, {"source": "docs_explanation_determinism_determinism", "target": "docs_explana