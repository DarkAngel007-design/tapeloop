{"nodes": [{"id": "security_security_policy", "label": "Security Policy", "file_type": "document", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The honest question is not is it safe but what is it safe against, and what is it not."}, {"id": "security_opt_in_safety_not_opt_out", "label": "Opt-In Safety, Not Opt-Out", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bare Agent(...) has policy=None and SubprocessExecutor, so model-authored shell runs on your host unrestricted. Stated first because a security document describing protections without saying they are off by default is worse than no document."}, {"id": "security_subprocess_executor", "label": "SubprocessExecutor \u2014 No Isolation", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timeouts and a working directory only. Protects against accidents, nothing else."}, {"id": "security_docker_executor", "label": "DockerExecutor \u2014 Isolation Against Untrusted Input", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No network, no capabilities, read-only root, workspace the sole writable mount, runs as the host uid. Raises if Docker is missing rather than degrading quietly."}, {"id": "security_a_tape_can_contain_secrets", "label": "A Tape Can Contain Secrets", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It records everything the tools read. Treat one like a debug log."}, {"id": "security_pre_commit_secret_guard", "label": "Pre-Commit Secret Guard", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real key once reached .env.example and had to be purged from six commits. Git does not install hooks on clone, so core.hooksPath must be set."}, {"id": "security_pythonbehaviour_executes_agent_code", "label": "PythonBehaviour Executes Agent-Written Code", "file_type": "concept", "source_file": "SECURITY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inherent to verifying a fix works, but it is arbitrary code execution. Eval-suite only, never the agent loop."}], "edges": [{"source": "security_security_policy", "target": "security_opt_in_safety_not_opt_out", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_subprocess_executor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_docker_executor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_a_tape_can_contain_secrets", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_pre_commit_secret_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SECURITY.md", "source_location": null, "weight": 1.0}, {"source": "security_security_policy", "target": "security_pythonbehaviour_executes_agen