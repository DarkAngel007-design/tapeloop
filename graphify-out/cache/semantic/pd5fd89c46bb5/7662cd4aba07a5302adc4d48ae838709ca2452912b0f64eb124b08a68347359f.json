{"nodes": [{"id": "docs_project_charter_charter", "label": "Charter", "file_type": "document", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The builder-facing counterpart to the README: the README sells the idea, the charter states the commitments."}, {"id": "docs_project_charter_contract_determinism", "label": "Contract 1 \u2014 Determinism Up To First Divergence", "file_type": "concept", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same tape plus same code reproduces exactly until something changes, then runs live. Enforced by a lint rule and a replay-equivalence test rather than discipline."}, {"id": "docs_project_charter_contract_step_keys", "label": "Contract 2 \u2014 Content-Addressed Step Keys", "file_type": "concept", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The prefix property is why forking is cheap, and it reinforces server-side prompt caching rather than fighting it."}, {"id": "docs_project_charter_contract_effect_classes", "label": "Contract 3 \u2014 Tools Declare Their Effects", "file_type": "concept", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replay is only sound if the runtime knows which tools touch the world. Undeclared defaults to write."}, {"id": "docs_project_charter_contract_replay_not_resume", "label": "Contract 4 \u2014 Replay Is Not Resume", "file_type": "concept", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conflating them yields a run that appears to succeed while the filesystem disagrees with the history."}, {"id": "docs_project_charter_contract_provider_neutral", "label": "Contract 5 \u2014 The Tape Is Provider-Neutral", "file_type": "concept", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This is what makes forking a run onto a different model possible at all."}, {"id": "docs_project_charter_success_criteria", "label": "Success Criteria", "file_type": "concept", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six observable facts. The project is finished as a piece of work when all hold."}, {"id": "docs_project_charter_out_of_scope", "label": "Explicitly Out Of Scope", "file_type": "concept", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stated so they do not get relitigated: not a framework, not hosted, not prompt management, not a provider zoo, not dependency-maximal."}, {"id": "docs_project_charter_local_endpoint_on_ramp", "label": "Local-Endpoint On-Ramp", "file_type": "concept", "source_file": "docs/project/charter.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running against Ollama or vLLM with no API credits is a requirement, not a nice-to-have: a runtime nobody can try is a runtime nobody adopts."}], "edges": [{"source": "docs_project_charter_charter", "target": "docs_project_charter_contract_determinism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/project/charter.md", "source_location": null, "weight": 1.0}, {"source": "docs_project_charter_charter", "target": "docs_project_charter_contract_step_keys", "relation": "references", "confidence": "EXTRACTED", "confid