{"nodes": [{"id": "docs_adr_0020_compaction_is_a_recorded_step_adr_0020", "label": "ADR-0020 \u2014 Compaction Is A Recorded Step, Not A Side Effect", "file_type": "document", "source_file": "docs/adr/0020-compaction-is-a-recorded-step.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Summarising is a model call and therefore nondeterministic; outside the step machinery it would break replay silently. Truncation deliberately is not this."}, {"id": "docs_adr_0020_compaction_is_a_recorded_step_compaction", "label": "Compaction As A Keyed, Cached Step", "file_type": "concept", "source_file": "docs/adr/0020-compaction-is-a-recorded-step.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaying a compacted run reuses the same summary from cache, so the run stays reproducible. The system prompt and the original task are never compacted."}, {"id": "docs_adr_0020_compaction_is_a_recorded_step_truncation", "label": "Truncation Is Deliberately Not A Step", "file_type": "concept", "source_file": "docs/adr/0020-compaction-is-a-recorded-step.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A pure, deterministic function of its input, so it happens inline and needs no record beyond the elision marker the model can already see."}], "edges": [{"source": "docs_adr_0020_compaction_is_a_recorded_step_adr_0020", "target": "docs_project_charter_contract_determinism", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0020-compaction-is-a-recorded-step.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0020_compaction_is_a_recorded_step_adr_0020", "target": "docs_adr_0020_compaction_is_a_recorded_step_compaction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file