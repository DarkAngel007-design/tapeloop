{"nodes": [{"id": "docs_adr_0017_permission_model_adr_0017", "label": "ADR-0017 \u2014 Permission Decisions Are Events On The Tape", "file_type": "document", "source_file": "docs/adr/0017-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a permission decision is not recorded, replay either re-prompts (useless in an eval) or silently assumes an answer, which is worse."}, {"id": "docs_adr_0017_permission_model_allow_ask_deny", "label": "allow / ask / deny, Per Tool And Per Argument", "file_type": "concept", "source_file": "docs/adr/0017-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "run_command(git status) is a different rule from run_command(*). First match wins; explicit deny beats explicit allow."}, {"id": "docs_adr_0017_permission_model_permissions_toml", "label": ".tapeloop/permissions.toml", "file_type": "concept", "source_file": "docs/adr/0017-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A permission set is a property of a codebase, not of a person, so it belongs in the repo where it can be reviewed in a pull request."}, {"id": "docs_adr_0017_permission_model_permission_is_a_tape_record", "label": "Permission Decisions Are Tape Records", "file_type": "concept", "source_file": "docs/adr/0017-permission-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replay reads the decision instead of asking again, which is what makes non-interactive evals possible at M6."}], "edges": [{"source": "docs_adr_0017_permission_model_adr_0017", "target": "docs_adr_0005_three_effect_classes_adr_0005", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0017-permission-model.md", "source_l