{"nodes": [{"id": "docs_explanation_provider_differences_divergence_table", "label": "The Divergence Table", "file_type": "document", "source_file": "docs/explanation/provider-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a divergence is not written here, the seam does not handle it. It is the spec, not documentation."}, {"id": "docs_explanation_provider_differences_tool_result_grouping", "label": "Divergence #2 \u2014 Tool-Result Grouping", "file_type": "concept", "source_file": "docs/explanation/provider-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The trap. Anthropic requires every parallel result in one user message; splitting them teaches the model to stop calling tools in parallel, and nothing errors."}, {"id": "docs_explanation_provider_differences_stop_reason_vocabulary", "label": "Divergence #3 \u2014 Stop-Reason Vocabulary", "file_type": "concept", "source_file": "docs/explanation/provider-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unrecognised value must map to OTHER, never END_TURN. A future stop reason that looks like a finished turn is a run that stops silently and wrongly."}, {"id": "docs_explanation_provider_differences_prompt_cache_control", "label": "Divergence #5 \u2014 Prompt-Cache Control", "file_type": "concept", "source_file": "docs/explanation/provider-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sat in the table verified by nothing until a test asserted every documented divergence has a check behind it."}, {"id": "docs_explanation_provider_differences_reasoning_payloads", "label": "Divergence #6 \u2014 Reasoning Payloads", "file_type": "concept", "source_file": "docs/explanation/provider-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Why opaque payloads exist. Stored with their origin, handed back untouched, dropped visibly on a cross-provider fork."}, {"id": "docs_explanation_provider_differences_strict_schemas", "label": "Divergence #7 \u2014 Strict Schemas", "file_type": "concept", "source_file": "docs/explanation/provider-differences.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The registry must emit the strictest common denominator so one schema ports everywhere. Easier to hold from the start than to retrofit."}], "edges": [{"source": "docs_explanation_provider_differences_divergence_table", "target": "docs_explanation_provider_differences_tool_result_grouping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/provider-differences.md", "source_location": null, "weight": 1.0}, {"source": "docs_explanation_provider_differences_divergence_table", "target": "docs_explanation_provider_differences_stop_reason_vocabulary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/provider-differences.md", "source_location": null, "weight": 1.0}, {"source": "docs_explanation_provider_differences_divergence_table", "target": "docs_explanation_provider_differences_prompt_cache_control", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/provider-differences.md", "source_location": null, "weight": 1.0}, {"source": "docs_explanation_provider_differences_divergence_table", "target": "docs_explanation_provider_differences_reasoning_payloads", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/provider-differences.md", "source_location": null, "weight": 1.0}, {"sou