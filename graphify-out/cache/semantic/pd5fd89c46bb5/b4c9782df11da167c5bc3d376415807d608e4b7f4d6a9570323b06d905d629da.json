{"nodes": [{"id": "docs_explanation_replay_vs_resume_replay_is_not_resume", "label": "Replay Is Not Resume", "file_type": "document", "source_file": "docs/explanation/replay-vs-resume.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two things people want from a tape look similar and are not. Conflating them produces a run that appears to succeed while the filesystem quietly disagrees."}, {"id": "docs_explanation_replay_vs_resume_restore_from", "label": "--restore-from N", "file_type": "concept", "source_file": "docs/explanation/replay-vs-resume.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resume does not rewind by default: when a long run dies the workspace already holds what it produced, and that state is what you are resuming. Restoring is the separate, explicit request and it destroys work after that step."}], "edges": [{"source": "docs_explanation_replay_vs_resume_replay_is_not_resume", "target": "docs_project_glossary_replay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/replay-vs-resume.md", "source_location": null, "weight": 1.0}, {"source": "docs_explanation_replay_vs_resume_replay_is_not_resume", "target": "docs_project_glossary_resume", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/replay-vs-resume.md", "source_location": null, "weight": 1.0}, {"source": "docs_explanation_replay_vs_resume_replay_is_not_resume", "target": "docs_explanation_replay_vs_resume_restore_from", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/explanation/replay-vs-resume.md", "source_location": null, "weight": 1.0}, {"source": "docs_explanation_replay_vs_resume_restore_from", "target": "src_tapeloop_sandbox_snapshot_snapshotstore", "relation": "implements