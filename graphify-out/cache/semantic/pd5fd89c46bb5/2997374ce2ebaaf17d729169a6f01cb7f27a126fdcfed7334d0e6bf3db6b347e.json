{"nodes": [{"id": "docs_adr_0016_fork_declares_its_own_soundness_adr_0016", "label": "ADR-0016 \u2014 Fork Declares Its Own Soundness From The Effects It Replayed", "file_type": "document", "source_file": "docs/adr/0016-fork-declares-its-own-soundness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refuse-without-snapshot makes fork unusable until M5; warn-always cries wolf; simulate-silently produces confidently wrong eval numbers. The effect classes already carry the information."}, {"id": "docs_adr_0016_fork_declares_its_own_soundness_faithful", "label": "faithful \u2014 No write In The Replayed Prefix", "file_type": "concept", "source_file": "docs/adr/0016-fork-declares-its-own-soundness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The workspace was never mutated, so the fork is genuinely what would have happened. Proceeds silently."}, {"id": "docs_adr_0016_fork_declares_its_own_soundness_simulated", "label": "simulated \u2014 A write Was Replayed From Cache", "file_type": "concept", "source_file": "docs/adr/0016-fork-declares-its-own-soundness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reported loudly, naming the specific tools and steps, because a warning that does not say which trains people to ignore warnings."}, {"id": "docs_adr_0016_fork_declares_its_own_soundness_require_faithful", "label": "--require-faithful", "file_type": "concept", "source_file": "docs/adr/0016-fork-declares-its-own-soundness.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Promotes simulated to a refusal. Evals use it: a number you cannot trust is worse than a number you do not have."}], "edges": [{"source": "docs_adr_0016_fork_declares_its_own_soundness_adr_0016", "target": "docs_adr_0