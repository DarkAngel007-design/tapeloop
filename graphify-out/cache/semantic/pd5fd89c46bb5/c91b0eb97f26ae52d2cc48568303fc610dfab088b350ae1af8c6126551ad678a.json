{"nodes": [{"id": "roadmap_roadmap", "label": "Roadmap", "file_type": "document", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ten milestones, each with a ship criterion that is an observable fact, not a feeling."}, {"id": "roadmap_m0", "label": "M0 \u2014 Bare Loop", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "137 code lines, no framework, two-tool task verified against a fake client and live."}, {"id": "roadmap_m1", "label": "M1 \u2014 Tool Registry, Effect Classes, Four Seams", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adding a tool is one decorated function; zero hand-written JSON Schema; the unimplemented Anthropic adapter type-checks."}, {"id": "roadmap_m2", "label": "M2 \u2014 Streaming, Interrupts, Retries", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Survives a forced 429 and a mid-stream Ctrl-C without corrupting the tape."}, {"id": "roadmap_m3", "label": "M3 \u2014 The Tape", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-running an unchanged agent is a 100% cache hit, byte-identical."}, {"id": "roadmap_m4", "label": "M4 \u2014 Replay, Fork, Diff", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editing the system prompt and forking at step 12 replays 0\u201311 in under a second."}, {"id": "roadmap_m5", "label": "M5 \u2014 Sandbox, Permissions, Resume", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A repo file that tries to instruct the agent is refused, and it is a test."}, {"id": "roadmap_m6", "label": "M6 \u2014 Eval Harness & First Numbers", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A committed results table with mean \u00b1 spread and a baseline to regress against. The first run scored 13/13 with no discriminating power, so five harder tasks were added before freezing."}, {"id": "roadmap_m7", "label": "M7 \u2014 Context Management", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A task that previously died on context completes, with the eval delta measured."}, {"id": "roadmap_m8", "label": "M8 \u2014 Subagents & MCP, Both Ends", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server runs in a different MCP host, driven by raw JSON-RPC with no tapeloop code on the sending side."}, {"id": "roadmap_m9", "label": "M9 \u2014 Viewer & Observability", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Someone who is not the author runs a task and can open their trace, with per-step cost visible."}, {"id": "roadmap_anthropic_adapter_not_a_milestone", "label": "The Anthropic Adapter \u2014 Deliberately Not A Milestone", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The day it passes the conformance suite unmodified is the day the provider abstraction is proven."}, {"id": "roadmap_m9_scope_cut", "label": "M9 Scope Cut \u2014 Worker Pool, Queue, Autoscaling", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A queue would exist only to let the README say production grade. Recorded here rather than quietly under-delivered against the wider criterion."}, {"id": "roadmap_why_the_order_is_what_it_is", "label": "Why The Order Is What It Is", "file_type": "concept", "source_file": "ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M7 and M8 both change what a trace contains, so a viewer built before either would be built twice \u2014 the same dependency argument that kept the sandbox until M5."}], "edges": [{"source": "roadmap_roadmap", "target": "roadmap_m0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "roadmap_m0", "target": "docs_project_glossary_ship_criterion", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "roadmap_roadmap", "target": "roadmap_m1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "roadmap_m1", "target": "docs_project_glossary_ship_criterion", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "roadmap_roadmap", "target": "roadmap_m2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ROADMAP.md", "source_location": null,