{"nodes": [{"id": "docs_evals_methodology_methodology", "label": "Evaluation Methodology", "file_type": "document", "source_file": "docs/evals/methodology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent runs are high-variance, so one pass is not a result \u2014 it is an anecdote you will end up quoting."}, {"id": "docs_evals_methodology_starter_v1", "label": "starter-v1 Suite", "file_type": "concept", "source_file": "docs/evals/methodology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-written and held out. A public benchmark the model memorized measures recall, not this harness."}, {"id": "docs_evals_methodology_mean_plus_spread", "label": "Mean \u00b1 Spread Across Seeds", "file_type": "concept", "source_file": "docs/evals/methodology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single run is not a result."}, {"id": "docs_evals_methodology_judged_and_deterministic_separate", "label": "Judged And Deterministic Reported Separately", "file_type": "concept", "source_file": "docs/evals/methodology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reader who distrusts LLM judging must be able to discount that half without recomputing anything."}, {"id": "docs_evals_methodology_graded_on_the_workspace", "label": "Graded On The Workspace, Not The Agent's Account Of Itself", "file_type": "concept", "source_file": "docs/evals/methodology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An agent reporting success it did not achieve is the commonest failure mode, and a grader reading the final message cannot tell the difference."}, {"id": "docs_evals_methodology_refusal_tasks", "label": "Refusal Tasks \u2014 Success Means Declining", "file_type": "concept", "source_file": "docs/evals/methodology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without these, a suite rewards eagerness and an agent that confidently does the wrong thing looks competent."}, {"id": "docs_evals_methodology_null_model_check", "label": "The Null-Model Check", "file_type": "concept", "source_file": "docs/evals/methodology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The suite runs against a do-nothing model in CI. Anything that passes is a task whose grader tests nothing. It caught fix-the-bug scoring 1.0 for doing nothing."}, {"id": "docs_evals_methodology_regression_policy", "label": "Regression Policy \u2014 One Spread", "file_type": "concept", "source_file": "docs/evals/methodology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A move greater than one spread is investigated before merging, not explained afterwards. Compare shared tasks only."}], "edges": [{"source": "docs_evals_methodology_methodology", "target": "docs_evals_methodology_starter_v1", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evals/methodology.md", "source_location": null, "weight": 1.0}, {"source": "docs_evals_methodology_methodology", "target": "docs_evals_methodology_mean_plus_spread", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evals/methodology.md", "source_location": null, "weight": 1.0}, {"source": "docs_evals_methodology_methodology", "target": "docs_evals_methodology_judged_and_deterministic_separate", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/evals/methodology.md", "source_location": null, "weight": 1.0}, {"source": "d